<Window
    x:Class="AsterismApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AsterismApp"
    Title="Asterism">
  <Grid x:Name="Root" Background="{StaticResource AppBackground}" RowDefinitions="48,*" KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="WorkspaceGraph_Invoked" />
      <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ExplorerToggle_Invoked" />
      <KeyboardAccelerator Key="Escape" Invoked="WorkspaceEscape_Invoked" />
    </Grid.KeyboardAccelerators>
    <Border x:Name="AppTitleBar" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="12,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition x:Name="CaptionButtonSpacer" Width="0" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="25" Height="25" Background="Transparent" CornerRadius="6">
            <Image Source="Assets/AsterismIcon-44.png" Stretch="Uniform" />
          </Border>
          <TextBlock Text="Asterism" FontSize="{Binding Ui, Source={StaticResource Typography}}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="⌄" Foreground="{StaticResource MutedText}" FontSize="{Binding Small, Source={StaticResource Typography}}" VerticalAlignment="Center" />
          <Border Width="1" Height="17" Background="{StaticResource CardBorder}" Margin="4,0" />
          <TextBlock Text="Personal knowledge constellation" Foreground="{StaticResource MutedText}" FontSize="{Binding Small, Source={StaticResource Typography}}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Style="{StaticResource QuietButton}" Padding="8,5" MinWidth="0" Click="Settings_Click" ToolTipService.ToolTip="설정" AutomationProperties.Name="설정">
            <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="{Binding Ui, Source={StaticResource Typography}}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ExplorerColumn" Width="232" />
        <ColumnDefinition x:Name="ExplorerDividerColumn" Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="ExplorerPanel" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0" Padding="10,12,9,10">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="2,0">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="▱" Foreground="{StaticResource PrimaryText}" FontSize="{Binding Ui, Source={StaticResource Typography}}" />
              <TextBlock Text="자료" FontSize="{Binding Ui, Source={StaticResource Typography}}" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="1" Content="TXT＋" Style="{StaticResource QuietButton}" Padding="6,3" MinWidth="0" Click="NewTextToRoot_Click" ToolTipService.ToolTip="저장소 최상단에 새 TXT 자료 만들기" />
            <Button Grid.Column="2" Content="PDF＋" Style="{StaticResource QuietButton}" Padding="6,3" MinWidth="0" Click="ImportPdfToRoot_Click" ToolTipService.ToolTip="PDF를 저장소에 추가" />
            <Button Grid.Column="3" Content="↻" Style="{StaticResource QuietButton}" Padding="7,3" MinWidth="0" Click="Refresh_Click" />
            <Button Grid.Column="4" Content="‹" Style="{StaticResource QuietButton}" Padding="7,3" MinWidth="0" Click="ExplorerCollapse_Click" ToolTipService.ToolTip="자료 탐색기 접기" />
          </Grid>
          <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource Field}" PlaceholderText="⌕  노트 본문·PDF 이름 검색" TextChanged="Search_TextChanged" />
          <ListView x:Name="NoteList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="NoteList_SelectionChanged" SelectionMode="Single" CanDragItems="True" DragItemsStarting="NoteList_DragItemsStarting" RightTapped="NoteList_RightTapped" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerTransitions>
              <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:VaultItem">
                <Border Background="Transparent" CornerRadius="6" Padding="5,6" Tag="{x:Bind Path}" Tapped="VaultItem_Tapped" RightTapped="VaultItem_RightTapped" AllowDrop="True" DragOver="VaultItem_DragOver" DragLeave="VaultItem_DragLeave" Drop="VaultItem_Drop">
                  <Grid ColumnDefinitions="Auto,14,14,*" ColumnSpacing="4">
                    <Border Width="{x:Bind Indent}" />
                    <Viewbox Grid.Column="1" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                      <Canvas Width="14" Height="14">
                        <Path Data="M4,2.5 L8.5,7 L4,11.5" Fill="Transparent" Stroke="{StaticResource MutedText}" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="{x:Bind CollapsedChevronOpacity}" />
                        <Path Data="M2.5,4 L7,8.5 L11.5,4" Fill="Transparent" Stroke="{StaticResource MutedText}" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="{x:Bind ExpandedChevronOpacity}" />
                        <Ellipse Canvas.Left="6" Canvas.Top="6" Width="2" Height="2" Fill="{StaticResource MutedText}" Opacity="{x:Bind NoteDotOpacity}" />
                      </Canvas>
                    </Viewbox>
                    <Viewbox Grid.Column="2" Width="12" Height="12" Opacity="{x:Bind FolderIconOpacity}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                      <Canvas Width="16" Height="16">
                        <Path Data="M1.5,4.4 C1.5,3.7 2.05,3.15 2.75,3.15 L6.15,3.15 L7.45,4.65 L13.25,4.65 C13.95,4.65 14.5,5.2 14.5,5.9 L14.5,11.6 C14.5,12.3 13.95,12.85 13.25,12.85 L2.75,12.85 C2.05,12.85 1.5,12.3 1.5,11.6 Z M1.5,6.05 L14.5,6.05" Fill="Transparent" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.82" />
                      </Canvas>
                    </Viewbox>
                    <Viewbox Grid.Column="2" Width="12" Height="12" Opacity="{x:Bind PdfIconOpacity}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                      <Canvas Width="16" Height="16">
                        <Path Data="M3,1.5 L9.5,1.5 L13,5 L13,14.5 L3,14.5 Z M9.5,1.5 L9.5,5 L13,5" Fill="Transparent" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.82" />
                        <Path Data="M5,8.2 L11,8.2 M5,10.5 L9.8,10.5 M5,12.8 L8.3,12.8" Fill="Transparent" Stroke="{StaticResource MutedText}" StrokeThickness="1" StrokeStartLineCap="Round" Opacity="0.85" />
                      </Canvas>
                    </Viewbox>
                    <Viewbox Grid.Column="2" Width="12" Height="12" Opacity="{x:Bind TextIconOpacity}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                      <Canvas Width="16" Height="16">
                        <Path Data="M3,1.5 L9.5,1.5 L13,5 L13,14.5 L3,14.5 Z M9.5,1.5 L9.5,5 L13,5" Fill="Transparent" Stroke="{StaticResource PrimaryText}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.82" />
                        <Path Data="M5,8 L11,8 M5,10.4 L11,10.4 M5,12.8 L9,12.8" Fill="Transparent" Stroke="{StaticResource MutedText}" StrokeThickness="1" StrokeStartLineCap="Round" Opacity="0.85" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="3" Text="{x:Bind DisplayName}" Height="14" VerticalAlignment="Center" FontSize="{Binding Ui, Source={StaticResource Typography}}" FontWeight="Normal" Foreground="{StaticResource PrimaryText}" LineHeight="14" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <Grid x:Name="ExplorerResizeDivider" Grid.Column="1" Background="Transparent" AutomationProperties.Name="자료 탐색기 너비 조절" ToolTipService.ToolTip="드래그하여 자료 탐색기 너비 조절">
        <Border Width="1" Background="{StaticResource CardBorder}" HorizontalAlignment="Center" IsHitTestVisible="False" />
        <local:HorizontalResizeBorder Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Thumb Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="자료 탐색기 너비 조절 손잡이" DragDelta="ExplorerDivider_DragDelta" DragCompleted="ExplorerDivider_DragCompleted" />
        </local:HorizontalResizeBorder>
      </Grid>

      <Border Grid.Column="2" Background="{StaticResource DocumentBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Height="38" VerticalAlignment="Top" Canvas.ZIndex="20">
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="16,3" VerticalAlignment="Stretch">
          <Button x:Name="ExplorerOpenButton" Content="›" Style="{StaticResource QuietButton}" Padding="8,5" MinWidth="0" Visibility="Collapsed" Click="ExplorerOpen_Click" ToolTipService.ToolTip="자료 탐색기 펼치기" AutomationProperties.Name="자료 탐색기 펼치기" />
          <Grid>
            <Button x:Name="DocumentModeButton" Content="문서" Style="{StaticResource QuietButton}" Padding="12,5" MinWidth="0" Click="DocumentMode_Click" ToolTipService.ToolTip="문서 보기" />
            <Border x:Name="DocumentModeIndicator" Height="2" Background="{StaticResource Positive}" VerticalAlignment="Bottom" Margin="8,0" IsHitTestVisible="False" />
          </Grid>
          <Grid>
            <Button x:Name="ConstellationModeButton" Content="성좌 지도" Style="{StaticResource QuietButton}" Padding="12,5" MinWidth="0" Click="ConstellationMode_Click" ToolTipService.ToolTip="현재 노트의 성좌 지도 열기 (Ctrl+G)" />
            <Border x:Name="ConstellationModeIndicator" Height="2" Background="{StaticResource Positive}" VerticalAlignment="Bottom" Margin="8,0" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid x:Name="DocumentGroupsHost" Grid.Column="2" Margin="0,38,0,0" ColumnSpacing="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
      <Border x:Name="DocumentPanel" Grid.Column="0" Background="{StaticResource DocumentBackground}" Padding="28,18,28,12">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock x:Name="DocumentKindText" Text="NOTE" Foreground="{StaticResource Positive}" FontSize="{Binding Small, Source={StaticResource Typography}}" FontWeight="SemiBold" />
              <Grid Height="30">
                <WebView2 x:Name="TitlePreview" DefaultBackgroundColor="#1E1E1E" IsHitTestVisible="False" Loaded="TitlePreview_Loaded" />
                <TextBox x:Name="TitleBox" Background="Transparent" BorderThickness="0" Padding="0,3" FontSize="{Binding Title, Source={StaticResource Typography}}" FontWeight="SemiBold" PlaceholderText="무엇을 기록할까요?" Opacity="0" TextChanged="TitleBox_TextChanged" GotFocus="TitleBox_GotFocus" LostFocus="TitleBox_LostFocus" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
              <Border x:Name="ReadOnlyBadge" Visibility="Collapsed" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,4">
                <TextBlock Text="읽기 전용 · 자동 업데이트" Foreground="{StaticResource MutedText}" FontSize="{Binding Small, Source={StaticResource Typography}}" />
              </Border>
              <Button Content="▥" Style="{StaticResource QuietButton}" Padding="8,5" MinWidth="0" Click="OpenCurrentToSide_Click" ToolTipService.ToolTip="현재 노트를 옆에 열기 (최대 3개)" AutomationProperties.Name="현재 노트를 옆에 열기" />
            </StackPanel>
          </Grid>
          <Grid x:Name="DocumentWorkspace" Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="PreviewRow" Height="2.125*" MinHeight="160" />
              <RowDefinition x:Name="EditorDividerRow" Height="8" />
              <RowDefinition x:Name="EditorRow" Height="*" MinHeight="130" />
            </Grid.RowDefinitions>
            <WebView2 x:Name="MarkdownPreview" Grid.Row="0" MaxWidth="820" HorizontalAlignment="Stretch" DefaultBackgroundColor="#1E1E1E" NavigationStarting="MarkdownPreview_NavigationStarting" />
            <Grid x:Name="EditorPreviewDivider" Grid.Row="1" Background="Transparent" AutomationProperties.Name="미리보기 편집기 크기 조절" ToolTipService.ToolTip="드래그하여 미리보기와 편집기 높이 조절">
              <Border Height="1" Background="{StaticResource CardBorder}" VerticalAlignment="Center" IsHitTestVisible="False" />
              <local:VerticalResizeBorder Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Thumb Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="미리보기 편집기 크기 조절 손잡이" DragDelta="EditorPreviewDivider_DragDelta" DragCompleted="EditorPreviewDivider_DragCompleted" />
              </local:VerticalResizeBorder>
            </Grid>
            <Border x:Name="EditorContainer" Grid.Row="2" MaxWidth="820" HorizontalAlignment="Stretch" Background="{StaticResource DocumentBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="Editor" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource DocumentBackground}" Foreground="{StaticResource PrimaryText}" PlaceholderForeground="{StaticResource PlaceholderText}" BorderThickness="0" CornerRadius="6" Padding="34,12" Margin="0" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="{Binding Body, Source={StaticResource Typography}}" PlaceholderText="Markdown으로 자유롭게 쓰세요.&#x0a;&#x0a;[[다른 노트 제목]]을 입력하면 자동으로 연결됩니다." TextChanged="Editor_TextChanged" KeyDown="Editor_KeyDown" LostFocus="Editor_LostFocus" Loaded="Editor_Loaded">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="#1E1E1E" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1E1E1E" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlForeground" Color="#D4D4D4" />
                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#D4D4D4" />
                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#D4D4D4" />
                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#858585" />
                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#858585" />
                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#858585" />
                <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#5A4B2A" />
                <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#555555" />
                <SolidColorBrush x:Key="ScrollBarThumbBackgroundPointerOver" Color="#707070" />
                <SolidColorBrush x:Key="ScrollBarThumbBackgroundPressed" Color="#808080" />
                <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="Transparent" />
              </TextBox.Resources>
              <TextBox.KeyboardAccelerators>
                <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="Editor_Save_Invoked" />
              </TextBox.KeyboardAccelerators>
            </TextBox>
            </Border>
          </Grid>
        </Grid>
      </Border>
      </Grid>

      <Border x:Name="ConstellationPanel" Grid.Column="2" Margin="0,38,0,0" Visibility="Collapsed" Background="#151515" Canvas.ZIndex="10">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="14,12,14,10">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock x:Name="ConstellationTitleText" Text="성좌 지도" FontWeight="SemiBold" FontSize="{Binding Ui, Source={StaticResource Typography}}" Foreground="#E0E0E0" />
              <TextBlock Text="현재 노트를 중심으로 주변 지식을 탐험합니다 · Esc로 문서 복귀" FontSize="{Binding Small, Source={StaticResource Typography}}" Foreground="#8F8F8F" />
            </StackPanel>
            <Button Grid.Column="1" Content="−" Style="{StaticResource QuietButton}" Padding="8,4" MinWidth="0" Click="GraphZoomOut_Click" ToolTipService.ToolTip="축소" />
            <TextBlock x:Name="GraphZoomText" Grid.Column="2" Text="100%" Foreground="#8F8F8F" FontSize="{Binding Small, Source={StaticResource Typography}}" VerticalAlignment="Center" Margin="8,0" />
            <Button Grid.Column="3" Content="＋" Style="{StaticResource QuietButton}" Padding="8,4" MinWidth="0" Click="GraphZoomIn_Click" ToolTipService.ToolTip="확대" />
          </Grid>
          <Grid Grid.Row="1">
            <ScrollViewer x:Name="GraphScroll" Background="#151515" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ZoomMode="Disabled" SizeChanged="GraphScroll_SizeChanged">
              <local:DirectionalCursorCanvas x:Name="GraphCanvas" Width="1200" Height="900" Background="#151515" DoubleTapped="GraphCanvas_DoubleTapped" PointerEntered="GraphCanvas_PointerEntered" PointerExited="GraphCanvas_PointerExited" PointerPressed="GraphCanvas_PointerPressed" PointerMoved="GraphCanvas_PointerMoved" PointerReleased="GraphCanvas_PointerReleased" PointerCanceled="GraphCanvas_PointerReleased" PointerCaptureLost="GraphCanvas_PointerReleased" />
            </ScrollViewer>
            <Expander Header="연결 정보" IsExpanded="False" Width="300" MaxHeight="650" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="{StaticResource SidebarBackground}" FontSize="{Binding Small, Source={StaticResource Typography}}" Canvas.ZIndex="20">
              <ScrollViewer MaxHeight="590" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" Padding="10,8,10,10">
                  <TextBlock x:Name="BacklinkTitle" Foreground="{StaticResource PrimaryText}" FontWeight="SemiBold" FontSize="{Binding Small, Source={StaticResource Typography}}" />
                  <ListView x:Name="BacklinkList" MaxHeight="120" Background="Transparent" BorderThickness="0" SelectionChanged="BacklinkList_SelectionChanged" SelectionMode="Single">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,3" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate x:DataType="local:NoteInfo"><Border Background="{StaticResource CardBackground}" CornerRadius="4" Padding="8,6"><TextBlock Text="{x:Bind Title}" FontSize="{Binding Small, Source={StaticResource Typography}}" Foreground="{StaticResource PrimaryText}" /></Border></DataTemplate></ListView.ItemTemplate>
                  </ListView>
                  <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,2" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="발견된 성좌" FontWeight="SemiBold" FontSize="{Binding Small, Source={StaticResource Typography}}" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SemanticStatusText" Grid.Column="1" Text="준비 중" Foreground="{StaticResource MutedText}" FontSize="{Binding Small, Source={StaticResource Typography}}" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl x:Name="SemanticSuggestionList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:SemanticSuggestion">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5" Margin="0,0,0,4">
                          <Button Tag="{x:Bind Note.Path}" Content="{x:Bind Note.Title}" Click="SemanticSuggestionOpen_Click" Background="{StaticResource CardBackground}" Foreground="{StaticResource PrimaryText}" BorderThickness="0" CornerRadius="4" Padding="8,6" FontSize="{Binding Small, Source={StaticResource Typography}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                          <TextBlock Grid.Column="1" Text="{x:Bind ScoreText}" Foreground="{StaticResource MutedText}" FontSize="{Binding Small, Source={StaticResource Typography}}" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Tag="{x:Bind Note.Path}" Content="＋ 링크" Click="SemanticSuggestionLink_Click" Style="{StaticResource QuietButton}" Padding="6,4" MinWidth="0" FontSize="{Binding Small, Source={StaticResource Typography}}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Expander Header="ChatGPT 대화 가져오기" IsExpanded="False" FontSize="{Binding Small, Source={StaticResource Typography}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="7" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                      <TextBox x:Name="ShareUrlBox" Style="{StaticResource Field}" PlaceholderText="공유 링크를 붙여 넣으세요" TextChanged="ShareUrl_TextChanged" />
                      <Button x:Name="ImportButton" Content="가져오기" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,7" FontSize="{Binding Small, Source={StaticResource Typography}}" IsEnabled="False" Click="ImportChat_Click" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </Expander>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="PdfPanel" Grid.Column="2" Margin="0,38,0,0" Visibility="Collapsed" Background="{StaticResource DocumentBackground}" Canvas.ZIndex="10">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="18,12,18,10" ColumnSpacing="7">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock x:Name="PdfTitleText" Text="PDF" FontWeight="SemiBold" FontSize="{Binding Ui, Source={StaticResource Typography}}" Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="PdfStatusText" Text="PDF 파일을 선택해 주세요." FontSize="{Binding Small, Source={StaticResource Typography}}" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Content="PDF 추가" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="ChangePdf_Click" />
            <Button Grid.Column="2" Content="파일 위치" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="OpenPdfLocation_Click" />
            <Button Grid.Column="3" Content="닫기" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="ClosePdf_Click" />
          </Grid>
          <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,1,0,0">
            <Grid RowDefinitions="Auto,*" Background="{StaticResource AppBackground}">
              <Grid Padding="14,8" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" Background="{StaticResource DocumentBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                <Button x:Name="PdfSelectToolButton" Grid.Column="0" Content="선택" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="PdfSelectTool_Click" ToolTipService.ToolTip="주석을 선택하거나 지웁니다" />
                <Button x:Name="PdfTextToolButton" Grid.Column="1" Content="텍스트" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="PdfTextTool_Click" ToolTipService.ToolTip="페이지를 클릭해 텍스트 추가" />
                <Button x:Name="PdfCalloutToolButton" Grid.Column="2" Content="□ 설명" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="PdfCalloutTool_Click" ToolTipService.ToolTip="사각형을 그리고 지시선이 있는 설명 추가" />
                <Button x:Name="PdfHighlightToolButton" Grid.Column="3" Content="하이라이터" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="PdfHighlightTool_Click" ToolTipService.ToolTip="드래그하여 강조 표시" />
                <Button Grid.Column="4" Content="실행 취소" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="PdfUndo_Click" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Button Content="‹" Style="{StaticResource QuietButton}" Padding="8,5" MinWidth="0" Click="PdfPreviousPage_Click" ToolTipService.ToolTip="이전 페이지" />
                  <TextBlock x:Name="PdfPageText" Text="0 / 0" Foreground="{StaticResource MutedText}" FontSize="{Binding Small, Source={StaticResource Typography}}" VerticalAlignment="Center" MinWidth="54" TextAlignment="Center" />
                  <Button Content="›" Style="{StaticResource QuietButton}" Padding="8,5" MinWidth="0" Click="PdfNextPage_Click" ToolTipService.ToolTip="다음 페이지" />
                </StackPanel>
                <Button Grid.Column="7" Content="−" Style="{StaticResource QuietButton}" Padding="8,5" MinWidth="0" Click="PdfZoomOut_Click" ToolTipService.ToolTip="축소" />
                <TextBlock x:Name="PdfZoomText" Grid.Column="8" Text="100%" Foreground="{StaticResource MutedText}" FontSize="{Binding Small, Source={StaticResource Typography}}" VerticalAlignment="Center" MinWidth="42" TextAlignment="Center" />
                <Button Grid.Column="9" Content="＋" Style="{StaticResource QuietButton}" Padding="8,5" MinWidth="0" Click="PdfZoomIn_Click" ToolTipService.ToolTip="확대" />
                <Button Grid.Column="10" Content="원본 열기" Style="{StaticResource QuietButton}" Padding="9,5" MinWidth="0" Click="OpenPdfExternally_Click" ToolTipService.ToolTip="기본 PDF 앱에서 검색·인쇄" />
              </Grid>
              <ScrollViewer x:Name="PdfScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="24" Background="{StaticResource AppBackground}" ViewChanged="PdfScroll_ViewChanged">
                <StackPanel x:Name="PdfPagesHost" Spacing="22" HorizontalAlignment="Center" VerticalAlignment="Top" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <WebView2 x:Name="ShareReader" Grid.Row="1" Width="1" Height="1" Opacity="0.01" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
  </Grid>
</Window>
